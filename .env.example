# ==============================================================================
# LIBORA - FIREBASE CONFIGURATION
# ==============================================================================
# In Expo, any environment variable prefixed with "EXPO_PUBLIC_" is automatically
# bundled into the client app and made available at runtime via process.env.
#
# Follow these steps to retrieve your exact production credentials:
# 1. Open Firebase Console: https://console.firebase.google.com/
# 2. Select or create your Firebase project (e.g. "libora-app")
# 3. In the project dashboard, click the Web icon (</>) to register a web app.
# 4. Under "Firebase SDK snippet" -> "Config", copy the fields into the values below:
# ==============================================================================

# Web API Key (Firebase Project Settings -> General -> Web API Key)
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here

# Auth Domain (usually: <your-project-id>.firebaseapp.com)
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=libora-app.firebaseapp.com

# Project ID (found in Project Settings -> General -> Project ID)
EXPO_PUBLIC_FIREBASE_PROJECT_ID=libora-app

# Cloud Storage Bucket (usually: <your-project-id>.firebasestorage.app or appspot.com)
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=libora-app.firebasestorage.app

# Cloud Messaging Sender ID (Project Settings -> Cloud Messaging -> Sender ID)
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012

# Firebase App ID (Project Settings -> General -> Your apps -> App ID)
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# ==============================================================================
# GOOGLE OAUTH CONFIGURATION (OPTIONAL FOR NATIVE MOBILE GOOGLE SIGN-IN)
# ==============================================================================
# Web Client ID (from Google Cloud Console OAuth 2.0 Credentials -> Web client)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Android Client ID (from Google Cloud Console OAuth 2.0 Credentials -> Android client)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# iOS Client ID (from Google Cloud Console OAuth 2.0 Credentials -> iOS client)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# ==============================================================================
# REQUIRED FIREBASE CONSOLE SERVICES TO ENABLE:
# ==============================================================================
# 1. Firebase Authentication:
#    - Go to: Firebase Console -> Build -> Authentication -> Sign-in method
#    - Enable "Email/Password" provider.
#    - (Optional) Enable "Anonymous" if you want guest users tracked in Firebase.
#
# 2. Cloud Firestore Database:
#    - Go to: Firebase Console -> Build -> Firestore Database -> Create database
#    - Choose production mode or test mode.
#    - Rules:
#      rules_version = '2';
#      service cloud.firestore {
#        match /databases/{database}/documents {
#          match /users/{userId} {
#            allow read: if true;
#            allow write: if request.auth != null && request.auth.uid == userId;
#          }
#          match /reviews/{reviewId} {
#            allow read: if true;
#            allow write: if request.auth != null;
#          }
#        }
#      }
# ==============================================================================
