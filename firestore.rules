rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users Collection:
    // - Allow reading profiles so readers can discover friends, see books, quotes, and lists.
    // - Only authenticated owners can write/update their own document.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Reviews Collection:
    // - Allow anyone to read public community book reviews.
    // - Only authenticated users can write reviews.
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Community Profiles (if published):
    match /community_users/{username} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
